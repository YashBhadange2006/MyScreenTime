<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bright_white"
    app:cardCornerRadius="24dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp"
    app:cardUseCompatPadding="@android:bool/config_enableMaterialDesignInPackageInstaller">

    <LinearLayout
        android:id="@+id/total_screen_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="20dp"
        android:paddingRight="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Screen Time"
            android:textSize="16dp"
            android:textColor="#5B6B7F"
            />

        <TextView
            android:id="@+id/total_screen_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0h 0m"
            android:textSize="32dp"
            android:textStyle="bold"
            android:textColor="#102A43"/>

        <!-- Description Text -->
        <TextView
            android:id="@+id/percent_comp_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12% less than yestarday."
            android:textColor="#4A5568"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/total_screen_breakdown_container"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="1"
            android:background="@drawable/breakdown_bar_background">
            <!-- Dynamic segments will be added here -->
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/breakdown_legend_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:chipSpacingVertical="4dp"
            app:chipSpacingHorizontal="8dp">
            <!-- Dynamic legend items will be added here -->
        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>


</com.google.android.material.card.MaterialCardView>


