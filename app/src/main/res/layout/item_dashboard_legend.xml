<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp">

    <View
        android:id="@+id/legend_color_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/circle_dot"
        app:layout_constraintBottom_toBottomOf="@id/legend_app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/legend_app_name" />

    <TextView
        android:id="@+id/legend_app_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="YouTube"
        android:textColor="#102A43"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/legend_percentage"
        app:layout_constraintStart_toEndOf="@id/legend_color_dot"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/legend_percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="44%"
        android:textColor="#102A43"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/legend_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3h 48m"
        android:textColor="#8A94A6"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/legend_percentage" />

</androidx.constraintlayout.widget.ConstraintLayout>
